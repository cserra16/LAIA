<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSMicrophoneUsageDescription</key>
    <string>LAIA necesita acceso al micrófono para escuchar tus preguntas y comandos de voz.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>LAIA utiliza reconocimiento de voz para transcribir lo que dices y poder responderte.</string>
    <key>NSPersonalVoiceUsageDescription</key>
    <string>LAIA puede usar tu Voz Personal para responder con tu propia voz, creando una experiencia más personalizada.</string>
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
    
    <!-- MCP: Permisos de Red Local -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>LAIA necesita conectarse al servidor local MCP para acceder a herramientas externas como datos meteorológicos y otros servicios.</string>
    
    <!-- Bonjour Services (opcional, para descubrimiento) -->
    <key>NSBonjourServices</key>
    <array>
        <string>_mcp._tcp</string>
    </array>
    
    <!-- App Transport Security: Permitir HTTP en desarrollo -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
